# Copy to .env.local for local development. On Vercel, add these in Project Settings > Environment Variables.
# Names only: never commit values.
# Self-hosted, required: MONGODB_URI, BETTER_AUTH_SECRET, SUPPRESSION_HASH_KEY, APP_URL (outside Vercel), ADMIN_EMAILS, EMAIL_FROM.
# MailCheap Cloud adds MAILCHEAP_CLOUD=true, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and RESEND_API_KEY.

# ─── Mode ──────────────────────────────────────────────────────────────────────

# Exactly "true" on MailCheap Cloud (mailcheap.ai): billing and plan limits, open sign-up, and MailCheap's own
# emails through Resend only. The server refuses to start without the Stripe keys
# and RESEND_API_KEY. Leave it unset on a self-hosted server: no billing, no limits, sign-in limited to the
# allowlist below. The public pages read it at build time, so set it for builds too.
MAILCHEAP_CLOUD=

# ─── Required ──────────────────────────────────────────────────────────────────

# MongoDB connection string with a database name, e.g. the Atlas string with /mailcheap before the "?".
# Locally: mongodb://127.0.0.1:27017/mailcheap. A replica set gets transactions; a plain mongod works without.
MONGODB_URI=

# Signs sessions and, through keys derived from it, every link in sent emails (unsubscribe, confirm, tracking).
# At least 32 random characters, or the server refuses to start: openssl rand -base64 48
# Rotating it signs everyone out and breaks the links in emails already sent.
BETTER_AUTH_SECRET=

# Keys the hashes of the never-email list every account on the server shares: addresses an email provider said don't
# exist, for 180 days, and spam traps, for good, which imports, signups and sends skip. Only keyed hashes are kept.
# At least 32 random characters of its own, never BETTER_AUTH_SECRET, or the server refuses to start:
# openssl rand -base64 48. Changing it empties the list.
SUPPRESSION_HASH_KEY=

# Public URL of the app, no trailing slash: email links, Stripe return URLs and Better Auth use it, and so
# do the docs, the OpenAPI document and /llms.txt (read at build time). On Vercel it defaults to the production
# domain.
APP_URL=http://localhost:3000

# ─── Sign-in ───────────────────────────────────────────────────────────────────

# Comma-separated emails that can open /admin. On a self-hosted server they can sign in too.
ADMIN_EMAILS=
# Self-hosted only: who else can sign in, comma-separated addresses and whole domains (jane@example.com, @example.org).
# Checked at every sign-in, by code or with Google. With this and ADMIN_EMAILS empty, nobody can sign in.
ALLOWED_EMAILS=

# MailCheap's own emails (sign-in codes, alerts) go through Resend when this is set. MailCheap Cloud requires it
# and never sends them any other way. A self-hosted server without it sends them through the email provider
# (SES, or a PostShiba tenant of their own), from EMAIL_FROM. Without either, development prints sign-in codes
# in the server console; production can't send them.
RESEND_API_KEY=
# From address of those emails, on a domain Resend or the email provider verified. Required on a self-hosted
# server; MailCheap Cloud's default is "MailCheap <hello@r.mailcheap.ai>". On PostShiba it needs a domain no
# newsletter sends from: a domain belongs to one tenant there.
EMAIL_FROM=

# Google sign-in. The button shows only when both are set. The allowlist applies.
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
# The same client connects Google Postmaster Tools on /admin, for Gmail's spam rates: add the redirect URI
# <APP_URL>/api/admin/postmaster/callback and enable the Gmail Postmaster Tools API in its project. It needs
# CREDENTIALS_ENCRYPTION_KEY and CRON_SECRET too; without them, or until an admin connects, nothing runs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the domain Postmaster Tools reads, one that DKIM-signs every email. Default SHARED_DOMAIN.
POSTMASTER_DOMAIN=

# ─── Billing (MailCheap Cloud only) ────────────────────────────────────────────

# Secret key of the Stripe account. Prices are found by lookup key (see the README), not by ID.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <APP_URL>/api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# ─── Sending ───────────────────────────────────────────────────────────────────

# Kill switch for readers' emails: nothing goes to them unless this is exactly "true". Sign-in codes and alerts
# don't wait for it.
SENDING_ENABLED=false

# postshiba, ses or sendhq. Empty: postshiba when POSTSHIBA_API_KEY is set, else ses. Any other value stops sending.
EMAIL_PROVIDER=

# Campaign emails per second across all accounts (default 14, 1 to 1000): SES's max send rate, PostShiba's
# bulk cluster cap per hour divided by 3600, or on SendHQ what your plan's daily volume allows. With Upstash Redis
# it's shared by every server instance.
SEND_RATE_PER_SECOND=

# ─── PostShiba ─────────────────────────────────────────────────────────────────

# A full access API key of the PostShiba team, and the team id (both on PostShiba's API keys page).
POSTSHIBA_API_KEY=
POSTSHIBA_TEAM_ID=
# The cluster every email goes out on: campaigns and their last-chance emails over HTTP inject, welcome,
# confirmation and test emails through POST /sends.
POSTSHIBA_BULK_CLUSTER_ID=
# Optional: a second cluster for welcome, confirmation and test emails, so they never wait behind a campaign.
POSTSHIBA_TRANSACTIONAL_CLUSTER_ID=
# Signing secret of the team-wide webhook endpoint <APP_URL>/api/webhooks/postshiba.
POSTSHIBA_WEBHOOK_SECRET=
# Optional, default https://app.postshiba.com and https://inject.postshiba.com/api/inject/v1.
POSTSHIBA_API_URL=
POSTSHIBA_INJECT_URL=
# 32 random bytes, base64: openssl rand -base64 32. Encrypts each tenant's SMTP password at rest (PostShiba
# shows it once), and Postmaster Tools' refresh token. Changing it makes them unreadable: those tenants need new
# credentials, and Postmaster Tools a new connection.
CREDENTIALS_ENCRYPTION_KEY=

# ─── SendHQ ────────────────────────────────────────────────────────────────────

# With EMAIL_PROVIDER=sendhq: an API key of the SendHQ workspace every account sends through.
SENDHQ_API_KEY=
# Signing secret (whsec_...) of the workspace's webhook endpoint <APP_URL>/api/webhooks/sendhq.
SENDHQ_WEBHOOK_SECRET=
# Optional, default https://sendhq.cc/api/v1.
SENDHQ_API_URL=

# ─── Amazon SES ────────────────────────────────────────────────────────────────

SES_REGION=us-east-1
# IAM keys for SES in the AWS account MailCheap sends from. Required for anything SES: there's no fallback to
# ~/.aws or other default AWS credentials. Vercel reserves the AWS_* names, hence SES_*.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# 12-digit ID of that AWS account: SES identity ARNs are built from it.
SES_AWS_ACCOUNT_ID=
# SNS topic ARN that receives bounces, complaints and deliveries at /api/webhooks/ses. Every account's
# configuration set (created with its SES tenant) publishes to it.
SES_SNS_TOPIC_ARN=
# Optional: SNS topic ARN that EventBridge feeds with SES tenant status changes and reputation findings,
# subscribed to /api/webhooks/ses-tenants. A paused tenant pauses the account.
SES_TENANT_SNS_TOPIC_ARN=

# ─── Domains ───────────────────────────────────────────────────────────────────

# Optional shared domain, with its DNS on Vercel: every newsletter without its own domain sends from
# hello@<slug>.SHARED_DOMAIN (a sending subdomain in its account's tenant, its records published by the DNS
# helper below) and has its archive at <slug>.SHARED_DOMAIN. Add _dmarc.SHARED_DOMAIN yourself, once. It can be APP_URL's own
# domain, as mailcheap.ai is on MailCheap Cloud: slugs can't take www or the other names in lib/reserved-slugs.js.
# Without it, newsletters send from a domain of their own.
SHARED_DOMAIN=
# Host that websites point at with a CNAME, e.g. cname.vercel-dns.com on Vercel: the shared subdomains MailCheap
# publishes (cname.vercel-dns.com when empty), and newsletters' own website domains, which their Website settings only
# offer with it set. A website domain goes live once its CNAME and a TXT record that proves the account controls it are
# found: add it to your Vercel project (or your web server) first, or its pages and links won't load. Without it,
# websites stay on the shared subdomain or at /archive/<slug> on APP_URL.
ARCHIVE_CNAME_TARGET=
# The DNS helper that publishes and removes the shared subdomains' records, and puts website domains on the app's
# Vercel project: on MailCheap Cloud a Vercel project of its own that holds the Vercel token, which the app never has.
# Each request is signed with DNS_BROKER_SECRET (32 random bytes: openssl rand -hex 32), the same value on both.
# Without them (a self-hosted server, local development) DNS automation is off and shared addresses can't be set up.
DNS_BROKER_URL=
DNS_BROKER_SECRET=

# ─── Upstash QStash (background sending and scheduling) ────────────────────────

# QStash calls APP_URL/api/jobs/*, so APP_URL must be public (or use the QStash dev server locally).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=

# ─── Images ────────────────────────────────────────────────────────────────────

# Uploads from the editor, the newsletter settings and the API, stored under accounts/<accountId>/images/.
# With IMAGES_S3_BUCKET set, new ones go to that S3 bucket and are served from IMAGES_CDN_URL; otherwise to
# Vercel Blob. Without either, uploads are off. Images uploaded before stay where they are: sent emails
# point at them.
IMAGES_S3_BUCKET=
IMAGES_S3_REGION=us-east-1
# Keys of an IAM user that can only put, get and delete objects under accounts/ in the bucket, and create
# invalidations on the CloudFront distribution. There's no fallback to ~/.aws or other default AWS
# credentials, and SES keeps its own keys.
IMAGES_S3_ACCESS_KEY_ID=
IMAGES_S3_SECRET_ACCESS_KEY=
# The CDN in front of the bucket (CloudFront with Origin Access Control), e.g. https://cdn.example.com.
# Set it for builds too: next/image allows its host then.
IMAGES_CDN_URL=
# The CloudFront distribution's ID, e.g. E2EXAMPLE123. After an account's purge deletes its images, it
# invalidates /accounts/<accountId>/* there: CloudFront would keep serving them for up to a year. Without
# it (Vercel Blob, another CDN), the purge skips that step.
IMAGES_CLOUDFRONT_DISTRIBUTION_ID=
# Vercel Blob, when there's no S3 bucket.
BLOB_READ_WRITE_TOKEN=

# ─── Optional ──────────────────────────────────────────────────────────────────

# Upstash Redis: rate limits shared by every server instance (sign-in codes, signups, REST and MCP requests
# per API key, PostShiba domain checks, send rates).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# A Telegram bot (from @BotFather) and the chat it posts to. Admin alerts an admin can act on are emails to ADMIN_EMAILS;
# the ones that need someone go to Telegram too, each at most once every 6 hours. Without both, nothing goes to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# An admin's own inbox, for replies to the emails telling an account's owner they can't send and only an admin can
# change it: their account blocked, or the email provider refusing their emails. Other replies go to MailCheap Cloud's
# support address, or to EMAIL_FROM on a self-hosted server.
URGENT_REPLY_TO=
# Lets a scheduler run APP_URL/api/cron/hourly with "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it):
# PostShiba's team status every hour, with an alert for what stops sending. And APP_URL/api/cron/postmaster every
# day: Gmail's spam rates from Google Postmaster Tools, once it's connected on /admin. And APP_URL/api/cron/list-hygiene
# every 6 hours: the lists of throwaway and spam domains, and the check of subscribers' domains. openssl rand -hex 32
CRON_SECRET=
# StopForumSpam's spam domains, for signups, imports and the list hygiene. Their terms only allow non-commercial use:
# set to 1 only for a non-commercial install, or once StopForumSpam has waived that for yours.
STOPFORUMSPAM_COMMERCIAL_OK=
