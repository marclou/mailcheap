# Copy to .env.local for local development. On Vercel, add these in Project Settings > Environment Variables.
# Required: DATABASE_URL, ADMIN_EMAIL, ADMIN_PASSWORD (12+ characters), SESSION_SECRET (32+). Everything else can wait.
# `neon link` and `neon deploy` write the Neon variables (DATABASE_URL, AWS_*, NEON_AI_GATEWAY_*, NEON_FUNCTION_*)
# into .env.local for you. Keep the rest of this file's keys in the same .env.local: `neon deploy --env .env.local`
# reads the sender function's settings from it.

# ─── Required ──────────────────────────────────────────────────────────────────

# Lakebase Postgres on Neon: the pooled connection string of the branch (neon env pull writes it).
# Create the tables with: npm run db:migrate
DATABASE_URL=

# The one dashboard login. The password needs at least 12 characters, or Mailcheap refuses to start.
# Changing either one signs out every session.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the login session and every link in your emails (unsubscribe, confirm, tracking).
# At least 32 random characters, or Mailcheap refuses to start: openssl rand -base64 48
# Changing it later breaks the unsubscribe links in emails already sent.
SESSION_SECRET=

# ─── App ───────────────────────────────────────────────────────────────────────

# Public URL of this app, used in email links and the archive. No trailing slash.
# On Vercel it defaults to the project's production domain; set it once you add your own domain.
APP_URL=http://localhost:3000

# Kill switch: nothing is sent unless this is exactly "true". Leave it off until SES and the sender function
# are set up. The sender function reads its own copy: run `neon deploy --env .env.local` after changing it.
SENDING_ENABLED=false

# ─── Email provider ────────────────────────────────────────────────────────────

# "ses" or "resend". Empty: Resend when RESEND_API_KEY is set, otherwise SES.
EMAIL_PROVIDER=

# ─── Resend (sending) ──────────────────────────────────────────────────────────

# A Full access API key from resend.com/api-keys (sending-only keys can't read domains).
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend webhook pointed at <sender function URL>/webhooks/resend or
# APP_URL/api/webhooks/resend, for the email.* events listed in the README.
RESEND_WEBHOOK_SECRET=

# ─── Amazon SES (sending) ──────────────────────────────────────────────────────

SES_REGION=us-east-1
# IAM user keys (see the README for the policy). Vercel reserves the AWS_* names, hence SES_*.
# Set them locally too: the AWS_* keys in .env.local belong to Neon Object Storage, and without SES_* the AWS SDK
# would try those against SES.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Configuration set whose event destination publishes to the SNS topic below.
SES_CONFIGURATION_SET=
# SNS topic ARN that receives bounces, complaints and deliveries at /api/webhooks/ses.
SES_SNS_TOPIC_ARN=

# Emails per second across all sends. SES: 1 to 14 (default 10). Resend: 1 to 100 (default 8, under its
# default 10 requests/s).
SEND_RATE_PER_SECOND=

# ─── Neon Function: the sender (background sending and scheduling) ────────────

# Shared by the app and the sender function: the app wakes the function with it after a send starts, and the
# function calls APP_URL/api/revalidate with it after it starts a scheduled send. 32+ random characters:
# openssl rand -base64 32
SENDER_SECRET=
# The function's URL. `neon deploy` writes it to .env.local as NEON_FUNCTION_SENDER_BASE_URL, which is enough
# locally. On Vercel, copy that value here. Without it, sends still go out, starting at the next cron minute.
SENDER_URL=

# ─── Optional ──────────────────────────────────────────────────────────────────

# Archive domains: news.example.com=weekly serves the "weekly" newsletter's archive at that domain.
# Comma-separated for several newsletters. Point the domain at this app first. It's the safer setup:
# issue HTML then never shares the dashboard's origin, and APP_URL/archive/weekly redirects there.
ARCHIVE_HOSTS=

# Neon Object Storage: image uploads in the editor, in the mailcheap-images bucket that neon.ts declares.
# Locally, `neon deploy` writes AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3 and AWS_REGION,
# and those are enough. Vercel reserves the AWS_* names, so copy the same four values into these there.
# Without them, uploads are off. HTML and Markdown campaigns can still use images hosted anywhere.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=

# Neon AI Gateway: subject line ideas in the editor. `neon deploy` writes both (aiGateway in neon.ts). Copy them
# to Vercel too. Without them, the ideas button is hidden. The gateway needs a paid Neon plan and AI Gateway credits.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# Any model the branch's gateway serves (GET $NEON_AI_GATEWAY_BASE_URL/v1/models). Default: claude-sonnet-5.
AI_MODEL=

# Alerts by email to ADMIN_EMAIL (spam complaints, paused sends, signup floods, rate limiter outages, and
# every login, new API key and send), sent through SES from this address on a verified domain,
# e.g. Mailcheap <alerts@mail.example.com>. Empty: logs only.
ALERT_FROM=
